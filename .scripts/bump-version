#! /bin/sh

VERSION=$(yq ".workspace.package.version" Cargo.toml)
IFS='.' read -r major minor patch <<< "$VERSION"
NEXT_VERSION="$major.$minor.$((patch + 1))"

echo "Bumping packages $VERSION -> $NEXT_VERSION -m '$*'"

# -- UPDATE CORE -- #
yq -i ".workspace.package.version = \"$NEXT_VERSION\"" Cargo.toml
cargo build
git add Cargo.toml Cargo.lock

git commit -m "$*"
git tag -a "$NEXT_VERSION" -m "$*"

# -- UPDATE CLI -- #
cd ../cli || exit 1
yq -i ".package.version = \"$NEXT_VERSION\"" Cargo.toml
cargo build
git add Cargo.toml Cargo.lock

git commit -m "$*"
git tag -a "$NEXT_VERSION" -m "$*"

# -- UPDATE WEBAPP -- #
cd ../web-app || exit 1
yq -i ".version = \"$NEXT_VERSION\"" package.json
bun install
git add package.json bun.lock

git commit -m "$*"
git tag -a "$NEXT_VERSION" -m "$*"

# -- UPDATE LANDING -- #
cd ../landing || exit 1
yq -i ".version = \"$NEXT_VERSION\"" package.json
bun install
git add package.json bun.lock

git commit -m "$*"
git tag -a "$NEXT_VERSION" -m "$*"
